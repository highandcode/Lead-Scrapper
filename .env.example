# ============================================================
# CLINIC LEAD INTELLIGENCE — Environment Variables
# Copy this file to .env.local and fill in your values.
# Set the same variables in your Vercel project dashboard.
# ============================================================

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER expose this client-side

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Apify — https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_...

# App — set to your Vercel deployment URL in production.
# Must match the port in the `dev` script (next dev -p 5000).
NEXT_PUBLIC_APP_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=Clinic Lead Intelligence

# Optional scraping config
SCRAPE_DELAY_MS=2000
MAX_CONCURRENT_SCRAPES=3
